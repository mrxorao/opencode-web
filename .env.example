# Web Terminal Port
OPENCODE_PORT=7681

# Web Terminal Login Credentials (Username:Password)
# Leave empty if you want to access without authentication
TTYD_AUTH=admin:admin123

# Optional: Groq API Key for ultra-fast Cloud Whisper transcription (defaults to whisper-large-v3)
# Dedicated exclusively to microphone speech-to-text (does not affect OpenCode AI models)
# Get a free key at https://console.groq.com/keys
VOICE_GROQ_API_KEY=

# Optional: Groq Whisper Model (e.g. whisper-large-v3, whisper-large-v3-turbo) - Defaults to whisper-large-v3
VOICE_GROQ_MODEL=whisper-large-v3

# Default Voice Recognition Language (EN, PT, or BR) - Defaults to EN if not specified
VOICE_LANGUAGE=EN

# AI Text-to-Speech (TTS) Voice Engine: browser (default - native web speech) or microsoft (Microsoft Edge Neural Voice)
VOICE_TTS_PROVIDER=browser

# Optional: Custom default prompt directive for Conversation Mode (leave empty for balanced default)
# VOICE_CONVERSATION_PROMPT=

# Optional: Automatically start opencode CLI on terminal launch (defaults to true)
AUTO_START_OPENCODE=true

# Optional: Limit Node memory heap for low-memory VPS (e.g. --max-old-space-size=256)
NODE_OPTIONS=--max-old-space-size=256

# Optional: Enable HTTPS for mobile microphone access on local network / Tailscale (self-signed SSL)
# If true, access via https://<IP>:7681 instead of http://
ENABLE_HTTPS=false

# Optional: Automatically update OpenCode AI CLI to the latest version when the container starts
AUTO_UPDATE=true
